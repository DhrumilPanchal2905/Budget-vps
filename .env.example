# Expo app environment (copy to .env). EXPO_PUBLIC_* values are built into the app — NO secrets here.
EXPO_PUBLIC_API_URL="https://budbackend.dhrumilpanchal.in"
EXPO_PUBLIC_SITE_URL="https://budget.dhrumilpanchal.in"
# From `eas init` (expo.dev project) — needed for native push notifications
EAS_PROJECT_ID=""
# EXPO_OWNER="your-expo-username"
# Local development against a local API:
# EXPO_PUBLIC_API_URL="http://localhost:4000"
