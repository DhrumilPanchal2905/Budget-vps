{
  "name": "budget-pro-app",
  "version": "4.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Budget Pro \u2014 one Expo codebase for Web, Android, iOS, tablets and iPad",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:web": "node scripts/build-web.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "fix-deps": "npx expo install --fix",
    "eas:android": "eas build -p android --profile production",
    "eas:ios": "eas build -p ios --profile production",
    "eas:submit:android": "eas submit -p android --latest",
    "eas:submit:ios": "eas submit -p ios --latest",
    "deploy:web": "bash scripts/deploy-web.sh"
  },
  "dependencies": {
    "@expo-google-fonts/inter": ">=0.2.3 <1.0.0",
    "@expo/metro-runtime": "~6.1.2",
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/datetimepicker": "~8.4.0",
    "@simplewebauthn/browser": "^13.1.0",
    "expo": "~54.0.0",
    "expo-application": "~7.0.0",
    "expo-clipboard": "~8.0.0",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.0",
    "expo-device": "~8.0.0",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "~14.0.0",
    "expo-speech": "~14.0.0",
    "expo-speech-recognition": "~2.1.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.0",
    "expo-web-browser": "~15.0.0",
    "lucide-react-native": "^0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "~0.81.0",
    "react-native-passkeys": "~0.3.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "~13.15.0",
    "sp-react-native-in-app-updates": "~1.4.0",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-passkeys",
        "sp-react-native-in-app-updates",
        "expo-speech-recognition"
      ]
    }
  }
}
