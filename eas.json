{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "local" },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://budbackend.dhrumilpanchal.in",
        "EXPO_PUBLIC_SITE_URL": "https://budget.dhrumilpanchal.in"
      }
    },
    "development": { "extends": "base", "developmentClient": true, "distribution": "internal" },
    "preview": { "extends": "base", "distribution": "internal", "android": { "buildType": "apk" } },
    "production": { "extends": "base", "android": { "buildType": "app-bundle" }, "ios": { "resourceClass": "m-medium" } }
  },
  "submit": {
    "production": {
      "android": { "serviceAccountKeyPath": "./play-service-account.json", "track": "production" },
      "ios": { "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID" }
    }
  }
}
